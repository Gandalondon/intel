<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ground">#FF141414</color>
    <style name="Theme.Intel" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Launch: the icon on ground, then the task (style guide: Screens and states) -->
    <style name="Theme.Intel.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Intel</item>
    </style>
</resources>
